<UserControl x:Class="Paul.uc.ucLogin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Paul.uc"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             Background="#FAF4EB">
    <Grid>
        <Button Content="←" HorizontalAlignment="Left" VerticalAlignment="Top" 
                FontSize="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="15"/>

        <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Identifiant" FontFamily="Georgia" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,5"/>
            <Border Background="#D4D4D4" CornerRadius="15" Height="40" Margin="0,0,0,15">
                <TextBox x:Name="TxtIdentifiant" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="12,0" FontSize="14"/>
            </Border>

            <TextBlock Text="Mot de passe" FontFamily="Georgia" FontSize="18" FontWeight="SemiBold" Foreground="Black" Margin="0,0,0,5"/>
            <Border BorderBrush="#4A90E2" BorderThickness="2" Background="#D4D4D4" CornerRadius="15" Height="40" Margin="0,0,0,25">
                <TextBox x:Name="TxtMotDePasse" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="12,0" FontSize="14"/>
            </Border>

            <Button Content="Se connecter" Height="40" Width="160" Foreground="White" FontSize="14" HorizontalAlignment="Center" Click="BtnConnexion_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>
</UserControl>
